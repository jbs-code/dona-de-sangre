---
import '../../styles/global.css'

// La sesión llega de verifyOtp en /auth/confirm (cookies httpOnly).
if (!Astro.locals.claims) {
  return Astro.redirect('/auth/login')
}
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Elige tu contraseña | Dona de sangre</title>
	</head>
	<body class="bg-base-200">
		<main class="flex min-h-svh items-center justify-center p-4 sm:p-6">
			<section class="card w-full max-w-sm bg-base-100 shadow-xl">
				<div class="card-body gap-4">
					<h1 class="card-title justify-center text-2xl">Elige tu contraseña</h1>
					<p class="text-center text-sm opacity-70">
						Define tu contraseña para entrar a Dona de sangre. No la compartas con nadie.
					</p>
					<form id="password-form" class="flex flex-col gap-4" method="post" action="/auth/update-password">
						<fieldset class="fieldset">
							<label class="label" for="password">Contraseña</label>
							<input
								id="password"
								name="password"
								type="password"
								class="input w-full"
								required
								minlength="8"
								autocomplete="new-password"
							/>
						</fieldset>
						<fieldset class="fieldset">
							<label class="label" for="password_confirm">Confirmar contraseña</label>
							<input
								id="password_confirm"
								name="password_confirm"
								type="password"
								class="input w-full"
								required
								minlength="8"
								autocomplete="new-password"
							/>
						</fieldset>
						<button id="password-submit" type="submit" class="btn btn-primary w-full">Guardar contraseña</button>
					</form>
				</div>
			</section>
		</main>

		<script>
			const form = document.getElementById('password-form')
			const submitButton = document.getElementById('password-submit')

			form?.addEventListener('submit', () => {
				if (!(submitButton instanceof HTMLButtonElement)) return

				submitButton.disabled = true
				submitButton.textContent = 'Guardando…'
			})
		</script>
	</body>
</html>
