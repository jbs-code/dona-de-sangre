---
import BaseLayout from '../../components/ui/BaseLayout.astro'
import AlertError from '../../components/ui/AlertError.astro'
import AuthCard from '../../features/auth/components/AuthCard.astro'
import FormField from '../../features/auth/components/FormField.astro'

const SUCCESS_MESSAGE =
	'Si ese correo está registrado, te enviamos un enlace a ese mismo correo para cambiar la contraseña.'

const ERROR_MESSAGES = {
	email_invalido: 'Introduce un correo electrónico válido.',
	envio_fallido: 'No se pudo enviar el correo. Inténtalo de nuevo en un momento.'
} as const

const sent = Astro.url.searchParams.get('estado') === 'enviado'

// Clave desconocida → undefined → null
const errorKey = Astro.url.searchParams.get('error')
const errorMessage =
	(errorKey && ERROR_MESSAGES[errorKey as keyof typeof ERROR_MESSAGES]) || null
---

<BaseLayout title="Recuperar contraseña | Dona de sangre">
	<AuthCard>
		<h1 class="card-title justify-center text-2xl">Recuperar contraseña</h1>
		<p class="text-center text-sm opacity-70">
			Escribe tu correo y te enviaremos un enlace para elegir una contraseña nueva.
		</p>
		{
			sent && (
				<div role="alert" class="alert alert-success alert-soft">
					<span>{SUCCESS_MESSAGE}</span>
				</div>
			)
		}
		{
			errorMessage && (
				<AlertError soft>
					<span>{errorMessage}</span>
				</AlertError>
			)
		}
		<form id="recovery-form" class="flex flex-col gap-4" method="post" action="/api/auth/recovery">
			<FormField id="email" label="Correo" type="email" required autocomplete="email" />
			<p class="text-sm opacity-70">
				Escribe el correo con el que te registraste: el enlace se enviará a ese mismo correo.
			</p>
			<button id="recovery-submit" type="submit" class="btn btn-primary w-full">Enviar enlace</button>
		</form>
		<a href="/auth/login" class="link link-hover mx-auto text-sm">Volver a iniciar sesión</a>
		<p class="text-center text-xs opacity-70">
			Si ya no tienes acceso a ese correo, pide al administrador que elimine la cuenta y cree una
			nueva con otro correo.
		</p>
	</AuthCard>

	<script>
		const form = document.getElementById('recovery-form')
		const submitButton = document.getElementById('recovery-submit')

		form?.addEventListener('submit', () => {
			if (!(submitButton instanceof HTMLButtonElement)) return

			submitButton.disabled = true
			submitButton.textContent = 'Enviando…'
		})
	</script>
</BaseLayout>
