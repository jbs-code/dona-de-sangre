---
interface Props {
	search: string
}

const { search } = Astro.props
---

<form method="get" action="/dashboard/admin/users" class="flex flex-col gap-3 sm:flex-row sm:items-end">
	<fieldset class="fieldset min-w-0 flex-1">
		<label class="label" for="users-search">Buscar por nombre o correo</label>
		<input
			id="users-search"
			name="q"
			type="search"
			class="input w-full"
			value={search}
			placeholder="Nombre o correo"
		/>
	</fieldset>

	<div class="flex gap-2">
		<button type="submit" class="btn btn-primary">Buscar</button>
		{search && <a href="/dashboard/admin/users" class="btn btn-ghost">Quitar filtro</a>}
	</div>
</form>
